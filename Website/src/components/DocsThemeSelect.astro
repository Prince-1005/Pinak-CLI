<label class="pinak-docs-theme"><span class="sr-only">Select theme</span><select aria-label="Select theme"><option value="dark">Dark</option><option value="light">Light</option></select></label>
<script>
  document.querySelectorAll<HTMLSelectElement>('.pinak-docs-theme select').forEach(select => {
    select.value = document.documentElement.dataset.theme || 'dark';
    select.addEventListener('change', () => {
      document.documentElement.dataset.theme = select.value;
      try { localStorage.setItem('pinak-theme', select.value); } catch {}
    });
  });
</script>
<style>.pinak-docs-theme select{font:inherit;font-size:.8rem;background:var(--sl-color-bg-nav);color:var(--sl-color-text);border:1px solid var(--sl-color-hairline);border-radius:4px;padding:.4rem}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}</style>
