{
  "name": "pinak-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/media.mjs && node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/media.mjs && node scripts/astro.mjs build && node scripts/validate.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "media:prepare": "node scripts/media.mjs --prepare",
    "media:build": "node scripts/media.mjs",
    "test": "node --test tests/media.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.7",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "astro": "^7.4.2",
    "marked": "^18.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lighthouse": "^13.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.35.5": true
  }
}
